{
  "name": "naver-content-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authless remote MCP server that scrapes Naver blog/news/cafe/place content from the Cloudflare edge.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node scripts/bundle.mjs",
    "test:worker": "node scripts/test_worker.mjs dist/worker.js",
    "test:tools": "node scripts/test_tools.mjs",
    "test:probe": "python3 scripts/naver_probe.py"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "fflate": "^0.8.3",
    "unpdf": "^1.8.0"
  }
}
